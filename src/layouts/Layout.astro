---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/quicksand";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../lib/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL("/og.png", SITE.url).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: "HealthApplication",
  operatingSystem: "Web",
  url: SITE.url,
  description: SITE.description,
  offers: {
    "@type": "Offer",
    price: SITE.priceAmount,
    priceCurrency: "EUR",
    description: "Por psicólogo al mes. Gratis para pacientes.",
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fde8da" />
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        setTimeout(() => {
          if (!("motionReady" in document.documentElement.dataset)) document.documentElement.classList.remove("motion");
        }, 3000);
      }
    </script>

    <link rel="icon" href="/favicon.ico?v=2" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Diariamente, seguimiento TCC entre sesiones para clínicas de psicología" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true" data-progress></div>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Navbar />
    <slot />
    <Footer />
    <Analytics />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
