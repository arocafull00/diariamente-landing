---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/quicksand";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../lib/site";
import { AUDIENCE, type Audience } from "../lib/audiences";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  copy?: Audience;
  path?: string;
}

const { title, description, noindex = false, copy = AUDIENCE, path = Astro.url.pathname } = Astro.props;
const landing = path === "/";
const canonical = new URL(path.replace(/(.)\/$/, "$1"), copy.url).href;
const ogImage = new URL("/og.png?v=2", copy.url).href;
const organizationId = `${copy.url}/#organization`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: SITE.name,
      alternateName: SITE.alternateNames,
      url: copy.url,
      logo: new URL("/icon-192.png", copy.url).href,
      email: SITE.legal.email,
      sameAs: [SITE.appUrl, SITE.playStoreUrl],
    },
    {
      "@type": "SoftwareApplication",
      name: SITE.name,
      alternateName: SITE.alternateNames,
      applicationCategory: "HealthApplication",
      operatingSystem: "Web, Android, iOS",
      url: copy.url,
      installUrl: SITE.playStoreUrl,
      description: copy.description,
      inLanguage: "es",
      publisher: { "@id": organizationId },
      offers: {
        "@type": "Offer",
        price: copy.offer.price,
        priceCurrency: "EUR",
        description: copy.offer.description,
      },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fde8da" />
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        setTimeout(() => {
          if (!("motionReady" in document.documentElement.dataset)) document.documentElement.classList.remove("motion");
        }, 3000);
      }
    </script>

    <link rel="icon" href="/favicon.ico?v=3" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icon-192.png?v=3" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true" data-progress></div>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Navbar copy={copy} landing={landing} />
    <slot />
    <Footer copy={copy} landing={landing} />
    <Analytics />
    <script is:inline define:vars={{ playStoreUrl: SITE.playStoreUrl }}>
      if (/android/i.test(navigator.userAgent)) {
        document.querySelectorAll("[data-start-link]").forEach((link) => link.setAttribute("href", playStoreUrl));
      }
    </script>
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
