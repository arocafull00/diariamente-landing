---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import Animo from "../components/illustrations/Animo.astro";
import Sparkle from "../components/illustrations/Sparkle.astro";
---

<Layout title="Página no encontrada · Diariamente" description="La página que buscas no existe. Vuelve al inicio de Diariamente." noindex>
  <main id="contenido" tabindex="-1" class="relative grid min-h-svh place-items-center overflow-hidden bg-sky-soft px-4 pt-28 pb-20 text-center">
    <div class="relative max-w-xl">
      <div class="relative mx-auto mb-12 size-32">
        <Animo tone="sky" face="sorprendida" label="¿Perdida?" class="inset-0" />
        <Sparkle class="absolute -top-4 -right-8 size-7 text-sun" />
      </div>
      <p class="font-display text-8xl tracking-tight">404</p>
      <h1 class="display-md mt-4">Esta página se ha perdido entre sesiones</h1>
      <p class="lead mt-6 text-ink/80">No encontramos lo que buscas, pero puedes seguir desde el inicio.</p>
      <div class="mt-10"><Button href="/">Volver al inicio</Button></div>
    </div>
  </main>
</Layout>
