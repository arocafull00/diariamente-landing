---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import logo from "../assets/logo-mark.png";
---

<Layout title="Página no encontrada · DiariaMente" description="La página que buscas no existe. Vuelve al inicio de DiariaMente." noindex>
  <main id="contenido" tabindex="-1" class="relative grid min-h-svh place-items-center overflow-hidden bg-lila px-4 pt-28 pb-20 text-center">
    <div class="relative max-w-xl">
      <div class="float mx-auto mb-8 size-32 rounded-full bg-white p-2 shadow-[0_20px_40px_-16px_#2e2a3566]">
        <Image src={logo} alt="" width={128} height={128} class="size-full" />
      </div>
      <p class="font-display text-8xl tracking-tight">404</p>
      <h1 class="display-md mt-4">Esta página se ha perdido entre sesiones</h1>
      <p class="lead mt-6 text-ink/80">No encontramos lo que buscas, pero la nutria te lleva de vuelta.</p>
      <div class="mt-10"><Button href="/">Volver al inicio</Button></div>
    </div>
  </main>
</Layout>
