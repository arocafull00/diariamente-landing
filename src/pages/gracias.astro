---
import Animo from "../components/illustrations/Animo.astro";
import Sparkle from "../components/illustrations/Sparkle.astro";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout title="Solicitud recibida · Diariamente" description="Hemos recibido tu solicitud de demo de Diariamente." noindex>
  <main id="contenido" tabindex="-1" class="grid min-h-svh place-items-center bg-sun-soft px-4 pt-28 pb-20 text-center">
    <div class="max-w-xl">
      <div class="relative mx-auto mb-12 size-32">
        <Animo tone="mint" face="emocionada" label="¡Hecho!" class="inset-0" />
        <Sparkle class="absolute -top-4 -left-8 size-7 text-coral" />
      </div>
      <h1 class="display-lg">¡Recibido!</h1>
      <p class="lead mt-6 text-ink/80">Te escribiremos muy pronto para organizar la demo de Diariamente con tu equipo.</p>
      <div class="mt-10"><Button href="/" >Volver al inicio</Button></div>
    </div>
  </main>
</Layout>
