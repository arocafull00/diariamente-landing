---
import { CircleCheck } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout title="Solicitud recibida · Diariamente" description="Hemos recibido tu solicitud de demo de Diariamente." noindex>
  <main id="contenido" tabindex="-1" class="grid min-h-svh place-items-center bg-sol-soft px-4 pt-28 pb-20 text-center">
    <div class="max-w-xl">
      <span class="mx-auto mb-8 grid size-20 place-items-center rounded-full bg-mint"><CircleCheck size={36} /></span>
      <h1 class="display-lg">¡Recibido!</h1>
      <p class="lead mt-6 text-ink/80">Te escribiremos muy pronto para organizar la demo de Diariamente con tu equipo.</p>
      <div class="mt-10"><Button href="/" variant="light">Volver al inicio</Button></div>
    </div>
  </main>
</Layout>
