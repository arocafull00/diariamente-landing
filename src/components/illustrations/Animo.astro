---
interface Props {
  variant: "01_gradiente" | "02_azul_rosa" | "03_verde_morado" | "04_naranja_amarillo" | "05_rosa_verde" | "alegria" | "ansiedad" | "rabia" | "tristeza";
  label?: string;
  class?: string;
  style?: string;
  parallax?: number;
}

const { variant, label, class: className, style, parallax } = Astro.props;
---

<div class:list={["animo", className]} style={style} data-parallax={parallax} aria-hidden="true">
  <div class="animo-body" data-animo>
    <div class="animo-float">
      <img src={`/caras/${variant}.svg`} alt="" width="160" height="160" class="animo-image" decoding="async" draggable="false" />
      {label && <span class="animo-label">{label}</span>}
    </div>
  </div>
</div>
