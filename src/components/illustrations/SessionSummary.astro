---
import { CalendarCheck } from "@lucide/astro";
---

<div class="card p-6">
  <p class="flex items-center gap-2 font-display text-xl"><CalendarCheck size={20} class="text-violet" /> Desde la última sesión</p>
  <p class="mt-1 text-xs text-ink-soft">Carlos · Ejemplo con datos ficticios</p>
  <p class="mt-5 text-lg"><strong>6</strong> registros nuevos</p>
  <dl class="mt-4 space-y-4 border-t border-line pt-4 text-sm">
    <div><dt class="font-bold">Emociones más frecuentes</dt><dd class="mt-1 text-ink-soft">Ansiedad · 3 registros<br />Calma · 2 registros</dd></div>
    <div><dt class="font-bold">Contextos que se repiten</dt><dd class="mt-1 text-ink-soft">Trabajo · Con compañeros</dd></div>
    <div><dt class="font-bold">Picos de intensidad</dt><dd class="mt-1 text-ink-soft">Ansiedad · 8 de 10 · Martes</dd></div>
  </dl>
</div>
