---
interface Props {
  label: string;
  value: number;
  tone: "coral" | "sky" | "sun" | "mint" | "violet";
}

const { label, value, tone } = Astro.props;

const toneClass = {
  coral: "bg-coral",
  sky: "bg-sky",
  sun: "bg-sun",
  mint: "bg-mint",
  violet: "bg-violet-light",
}[tone];
---

<div class="flex items-center gap-3 text-[0.8rem]">
  <span class="w-16 shrink-0 text-ink-soft">{label}</span>
  <div class="h-2.5 flex-1 overflow-hidden rounded-full bg-cream">
    <div class:list={["h-full rounded-full", toneClass]} style={`width: ${value * 10}%`} data-bar></div>
  </div>
  <span class="w-5 text-right font-bold tabular-nums">{value}</span>
</div>
