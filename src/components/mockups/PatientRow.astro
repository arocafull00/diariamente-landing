---
interface Props {
  name: string;
  initials: string;
  avatar: string;
  last: string;
  unread: number;
  active?: boolean;
}

const { name, initials, avatar, last, unread, active = false } = Astro.props;
---

<li
  class:list={[
    "flex items-center gap-3 rounded-xl px-3 py-2.5",
    active ? "bg-lila-soft" : "bg-transparent",
  ]}
>
  <span class:list={["grid size-9 shrink-0 place-items-center rounded-full text-xs font-bold", avatar]}>{initials}</span>
  <span class="min-w-0 flex-1">
    <span class="block truncate text-sm font-bold">{name}</span>
    <span class="block truncate text-xs text-ink-soft">{last}</span>
  </span>
  {
    unread > 0 && (
      <span class="rounded-full bg-coral px-2 py-0.5 text-[0.7rem] font-bold whitespace-nowrap">{unread} {unread === 1 ? "nuevo" : "nuevos"}</span>
    )
  }
</li>
