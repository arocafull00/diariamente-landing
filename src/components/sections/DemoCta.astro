---
import { CircleCheck } from "@lucide/astro";
import FormField from "../FormField.astro";
import { TEAM_SIZES } from "../../lib/demo-request";
import { SITE } from "../../lib/site";

const inputClass =
  "h-13 w-full rounded-xl border border-line bg-cream/70 px-4 text-base text-ink transition-colors placeholder:text-ink-soft focus:border-violet focus:bg-white";
---

<section id="demo" class="relative overflow-hidden bg-lila pt-28 pb-28 sm:pt-36 sm:pb-36">
  <div class="shell relative grid items-start gap-14 lg:grid-cols-[1fr_1.05fr]">
    <div class="lg:sticky lg:top-32" data-reveal="left">
      <h2 class="display-lg">Ve cómo encaja en tu clínica</h2>
      <p class="lead mt-8 max-w-xl text-ink/80">
        Te enseñamos el registro del paciente y cómo preparar la sesión desde la vista del psicólogo.
      </p>
    </div>

    <div class="card relative p-6 sm:p-10" data-reveal="scale" style="--delay: 120ms">
      <form action="/api/demo" method="post" class="grid gap-5 sm:grid-cols-2" data-demo-form>
        <FormField name="name" label="Nombre">
          <input name="name" autocomplete="name" required class={inputClass} placeholder="Ana López" />
        </FormField>
        <FormField name="clinic" label="Clínica o consulta">
          <input name="clinic" autocomplete="organization" required class={inputClass} placeholder="Centro Psicológico Alba" />
        </FormField>
        <FormField name="email" label="Email">
          <input name="email" type="email" autocomplete="email" required class={inputClass} placeholder="ana@clinica.es" />
        </FormField>
        <FormField name="phone" label="Teléfono" optional>
          <input name="phone" type="tel" autocomplete="tel" class={inputClass} placeholder="600 000 000" />
        </FormField>
        <FormField name="teamSize" label="¿Cuántos psicólogos sois?" class="sm:col-span-2">
          <select name="teamSize" required class={inputClass}>
            <option value="" disabled selected>Elige una opción</option>
            {TEAM_SIZES.map((size) => <option value={size}>{size}</option>)}
          </select>
        </FormField>
        <FormField name="message" label="¿Algo que debamos saber?" optional class="sm:col-span-2">
          <textarea name="message" rows="4" class:list={[inputClass, "h-auto resize-y py-3"]} placeholder="Cómo hacéis ahora el seguimiento, qué os gustaría mejorar..."></textarea>
        </FormField>

        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>No rellenar <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="sm:col-span-2">
          <label class="flex items-start gap-3 text-sm text-ink-soft">
            <input name="consent" type="checkbox" required class="mt-0.5 size-5 shrink-0 accent-violet" />
            <span>
              Acepto que DiariaMente use estos datos para contactarme sobre la demo, según la{" "}
              <a href="/privacidad" class="font-bold text-ink underline underline-offset-2">política de privacidad</a>.
            </span>
          </label>
          <span id="consent-error" class="mt-1.5 hidden text-sm font-bold text-[#c42a3a]" data-error-for="consent"></span>
        </div>

        <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
          <button type="submit" class="btn">
            <span data-submit-label>Solicitar mi demo</span>
          </button>
          <p class="text-sm font-bold" role="status" aria-live="polite" data-form-status></p>
        </div>
      </form>

      <div class="hidden flex-col items-center py-10 text-center" data-form-success role="status" tabindex="-1">
        <span class="mb-6 grid size-16 place-items-center rounded-full bg-mint"><CircleCheck size={30} /></span>
        <p class="display-md">¡Recibido!</p>
        <p class="mt-3 max-w-sm text-ink-soft">Te escribiremos muy pronto para organizar la demo.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, spring } from "motion";

  const form =document.querySelector<HTMLFormElement>("[data-demo-form]");
  const status = document.querySelector<HTMLElement>("[data-form-status]");
  const success = document.querySelector<HTMLElement>("[data-form-success]");
  const label = document.querySelector<HTMLElement>("[data-submit-label]");
  if (form) form.noValidate = true;

  const clearErrors = () => {
    form?.querySelectorAll("[aria-invalid]").forEach((control) => {
      control.removeAttribute("aria-invalid");
      control.removeAttribute("aria-describedby");
    });
    document.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => {
      el.textContent = "";
      el.classList.add("hidden");
    });
  };

  const showErrors = (fields: Record<string, string>) => {
    for (const [name, message] of Object.entries(fields)) {
      const el = document.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (!el) continue;
      el.textContent = message;
      el.classList.remove("hidden");
      const control = form?.querySelector(`[name="${name}"]`);
      control?.setAttribute("aria-invalid", "true");
      control?.setAttribute("aria-describedby", el.id);
    }
    const first = Object.keys(fields)[0];
    if (first) form?.querySelector<HTMLElement>(`[name="${first}"]`)?.focus();
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>("[type='submit']");
    if (!status || !label || !submit || submit.disabled) return;

    clearErrors();
    status.textContent = "";
    label.textContent = "Enviando...";
    submit.disabled = true;
    form.setAttribute("aria-busy", "true");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result: { ok: boolean; error?: string; fields?: Record<string, string> } = await response.json();

      if (result.ok) {
        form.classList.add("hidden");
        success?.classList.replace("hidden", "flex");
        success?.focus();
        if (success && document.documentElement.classList.contains("motion")) {
          animate(success, { opacity: [0, 1], scale: [0.9, 1] }, { type: spring, bounce: 0.45, visualDuration: 0.6 });
        }
        return;
      }

      status.textContent = result.error ?? "Algo ha fallado.";
      if (result.fields) showErrors(result.fields);
    } catch {
      status.textContent = "No hemos podido enviar la solicitud. Revisa tu conexión.";
    } finally {
      label.textContent = "Solicitar mi demo";
      submit.disabled = false;
      form.removeAttribute("aria-busy");
    }
  });
</script>
