---
import { BellRing, Smartphone } from "@lucide/astro";
import FeatureRow from "../FeatureRow.astro";
import RecordStack from "../illustrations/RecordStack.astro";
import SessionSummary from "../illustrations/SessionSummary.astro";

const privacyItems = [
  "Solo el psicólogo vinculado ve los registros",
  "Sin datos clínicos en las notificaciones",
  "El paciente puede desvincularse cuando quiera",
  "Borrado completo cuando el paciente lo pide",
];
---

<section id="psicologo" class="relative bg-cream pb-24 sm:pb-32">
  <div class="shell">
    <h2 class="display-lg mx-auto mb-16 max-w-3xl text-center sm:mb-24" data-split>Prepara la sesión con lo que ya ha pasado</h2>

    <div class="space-y-20 sm:space-y-28">
      <FeatureRow
        tone="coral"
        title="Revisa lo que necesita atención"
        text="Consulta las emociones, el contexto y la reflexión de cada paciente. Distingue los registros nuevos y añade tus propias notas privadas."
      >
        <RecordStack />
      </FeatureRow>

      <FeatureRow
        tone="sky"
        reverse
        title="Desde vuestra última sesión"
        text="Un resumen reúne los registros nuevos, las emociones más frecuentes, los contextos que se repiten y los picos de intensidad. Puedes abrir cada registro para profundizar."
      >
        <SessionSummary />
      </FeatureRow>

      <FeatureRow
        tone="sun"
        title="En su móvil, sin pasar por una tienda"
        text="Tu paciente puede instalar DiariaMente desde el navegador y activar el recordatorio diario. Su acceso es gratuito."
      >
        <div class="space-y-3" data-stagger style="--delay: 250ms">
          <div class="card flex items-center gap-3 p-4" data-wiggle>
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-sun" data-wiggle-target><BellRing size={20} /></span>
            <div class="text-sm">
              <p class="font-bold">DiariaMente · ahora</p>
              <p class="text-ink-soft">¿Cómo ha ido tu día? Tómate un momento para registrarlo.</p>
            </div>
          </div>
          <div class="card ml-8 flex items-center gap-3 p-4" data-lift>
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-lila-soft"><Smartphone size={20} /></span>
            <div class="text-sm">
              <p class="font-bold">Instalada en el móvil</p>
              <p class="text-ink-soft">Funciona en iPhone, Android y ordenador.</p>
            </div>
          </div>
        </div>
      </FeatureRow>

      <FeatureRow
        tone="mint"
        reverse
        title="El paciente controla la vinculación"
        text="Cada profesional accede a los registros de sus pacientes vinculados. El paciente puede desvincularse y dejar de compartirlos cuando quiera."
      >
        <ul class="card divide-y divide-line px-6 text-[0.95rem]" data-stagger style="--delay: 250ms">
          {privacyItems.map((item) => <li class="py-4" data-nudge>{item}</li>)}
        </ul>
      </FeatureRow>
    </div>
  </div>
</section>
