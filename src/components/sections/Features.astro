---
import { BellRing, Check, Smartphone } from "@lucide/astro";
import FeatureRow from "../FeatureRow.astro";
import RecordStack from "../illustrations/RecordStack.astro";
import SessionSummary from "../illustrations/SessionSummary.astro";
import { emphasize, type Audience } from "../../lib/audiences";

interface Props {
  copy: Audience;
}

const { copy } = Astro.props;
---

<section id="psicologo" class="relative bg-cream pb-24 sm:pb-32">
  <div class="shell">
    <h2 class="display-lg mx-auto mb-16 max-w-3xl text-center sm:mb-24" data-split set:html={emphasize(copy.features.title, "font-semibold text-[#d23a4c]")} />

    <div class="space-y-20 sm:space-y-28">
      <FeatureRow
        tone="coral"
        title={copy.features.rows[0].title}
        text={copy.features.rows[0].text}
      >
        <RecordStack />
      </FeatureRow>

      <FeatureRow
        tone="sky"
        reverse
        title={copy.features.rows[1].title}
        text={copy.features.rows[1].text}
      >
        <SessionSummary />
      </FeatureRow>

      <FeatureRow
        tone="sun"
        title={copy.features.rows[2].title}
        text={copy.features.rows[2].text}
      >
        <div class="space-y-3" data-stagger style="--delay: 250ms">
          <div class="card flex items-center gap-3 p-4" data-wiggle>
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-coral" data-wiggle-target><BellRing size={20} /></span>
            <div class="text-sm">
              <p class="font-bold">Diariamente · ahora</p>
              <p class="text-ink-soft">¿Cómo ha ido tu día? Tómate un momento para registrarlo.</p>
            </div>
          </div>
          <div class="card ml-8 flex items-center gap-3 p-4" data-lift>
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-mint"><Smartphone size={20} /></span>
            <div class="text-sm">
              <p class="font-bold">Instalada en el móvil</p>
              <p class="text-ink-soft">Funciona en iPhone, Android y ordenador.</p>
            </div>
          </div>
        </div>
      </FeatureRow>

      <FeatureRow
        tone="mint"
        reverse
        title={copy.features.rows[3].title}
        text={copy.features.rows[3].text}
      >
        <ul class="card divide-y divide-line px-6 text-[0.95rem]" data-stagger style="--delay: 250ms">
          {copy.features.privacy.map((item) => <li class="flex items-center gap-3 py-4" data-nudge><span class="grid size-6 shrink-0 place-items-center rounded-full bg-mint"><Check size={14} stroke-width={3} /></span>{item}</li>)}
        </ul>
      </FeatureRow>
    </div>
  </div>
</section>
