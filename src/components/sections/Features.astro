---
import { Brain, CalendarHeart, Footprints, Heart, PersonStanding } from "@lucide/astro";
import FeatureRow from "../FeatureRow.astro";
import RecordStack from "../illustrations/RecordStack.astro";
import SessionSummary from "../illustrations/SessionSummary.astro";
import { emphasize, type Audience } from "../../lib/audiences";

interface Props {
  copy: Audience;
}

const { copy } = Astro.props;

const QUESTION_ICONS = [
  { icon: CalendarHeart, chip: "bg-coral" },
  { icon: Brain, chip: "bg-sky" },
  { icon: Heart, chip: "bg-sun" },
  { icon: PersonStanding, chip: "bg-mint" },
  { icon: Footprints, chip: "bg-coral" },
];
---

<section id="psicologo" class="relative bg-cream pb-24 sm:pb-32">
  <div class="shell">
    <h2 class="display-lg mx-auto mb-16 max-w-3xl text-center sm:mb-24" data-split set:html={emphasize(copy.features.title, "font-semibold text-[#d23a4c]")} />

    <div class="space-y-20 sm:space-y-28">
      <FeatureRow
        tone="coral"
        title={copy.features.rows[0].title}
        text={copy.features.rows[0].text}
      >
        <RecordStack />
      </FeatureRow>

      <FeatureRow
        tone="sky"
        reverse
        title={copy.features.rows[1].title}
        text={copy.features.rows[1].text}
      >
        <SessionSummary />
      </FeatureRow>

      <FeatureRow
        tone="sun"
        title={copy.features.notes.title}
        text={copy.features.notes.text}
      >
        <ul class="card divide-y divide-line px-5 text-[0.95rem] font-semibold" data-stagger style="--delay: 250ms">
          {copy.features.notes.questions.map((question, index) => {
            const { icon: Icon, chip } = QUESTION_ICONS[index];
            return <li class="flex items-center gap-3 py-3.5" data-nudge><span class:list={["grid size-9 shrink-0 place-items-center rounded-full", chip]}><Icon size={18} /></span>{question}</li>;
          })}
        </ul>
      </FeatureRow>
    </div>
  </div>
</section>
