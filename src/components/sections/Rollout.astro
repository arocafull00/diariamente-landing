---
import RolloutStep from "../RolloutStep.astro";
---

<section class="bg-white py-24 sm:py-32">
  <div class="shell">
    <h2 class="display-lg mb-14 max-w-3xl" data-split>Cómo empezar</h2>
    <ol class="grid gap-10 md:grid-cols-3 md:gap-8" data-stagger>
      <RolloutStep index={1} title="Mira cómo encaja" text="Revisamos contigo el registro del paciente y la vista del psicólogo en una demo sin compromiso." />
      <RolloutStep index={2} title="Crea las cuentas del equipo" text="Cada psicólogo tiene su propio acceso y gestiona a sus pacientes." />
      <RolloutStep index={3} title="Vincula a tus pacientes" text="Comparte una invitación. Tras aceptar la vinculación, puedes consultar sus registros." />
    </ol>
  </div>
</section>
