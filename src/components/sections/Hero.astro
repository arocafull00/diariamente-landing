---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import symbol from "../../assets/diariamente-simbolo-color.svg";
import Button from "../Button.astro";
import DashboardMockup from "../mockups/DashboardMockup.astro";
import PhoneMockup from "../mockups/PhoneMockup.astro";
---

<section class="relative overflow-hidden bg-sol-soft pt-32 pb-40 sm:pt-40 md:pb-56" data-hero>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-24 -left-24 size-80 rounded-full bg-white/40 blur-3xl" data-parallax="-0.6"></div>
    <div class="absolute top-40 -right-32 size-96 rounded-full bg-arcilla/35 blur-3xl" data-parallax="0.8"></div>
    <div class="absolute bottom-10 left-1/3 size-72 rounded-full bg-sun/25 blur-3xl" data-parallax="-0.4"></div>
  </div>

  <div class="shell relative text-center" data-hero-copy>
    <h1 class="display-xl mx-auto max-w-5xl" data-split>
      Llega a cada sesión <span class="text-pizarra-deep">con más contexto</span>
    </h1>
    <p class="lead mx-auto mt-12 max-w-2xl text-ink/80" data-reveal style="--delay: 160ms">
      Tus pacientes registran emociones, pensamientos y situaciones. Tu equipo revisa lo que ha ocurrido entre consultas.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3" data-stagger style="--delay: 320ms">
      <Button href="#demo">Ver Diariamente en acción</Button>
      <a href="#precios" class="text-link px-3 py-3">Ver precios <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
  </div>

  <div class="shell relative mt-16 perspective-[1400px] sm:mt-20" data-reveal="scale" style="--delay: 420ms">
    <div class="relative mx-auto max-w-5xl" data-hero-stage>
      <DashboardMockup />
      <div class="absolute -bottom-24 -left-3 hidden lg:block xl:-left-16" data-parallax="-0.35">
        <PhoneMockup class="origin-bottom-left scale-90 -rotate-3" />
      </div>
      <div class="absolute -top-16 -left-4 hidden sm:block lg:-left-12" data-parallax="-0.5">
        <div class="float size-28 rounded-full bg-white p-4 shadow-[0_20px_40px_-16px_#25282c66] lg:size-36 lg:p-5">
          <Image src={symbol} alt="" width={144} height={144} class="size-full" />
        </div>
      </div>
    </div>
    <p class="mt-8 text-center text-xs text-ink-soft lg:mt-10">Vista ilustrativa de la app con datos ficticios.</p>
  </div>
</section>
