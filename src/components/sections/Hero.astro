---
import { ArrowRight, Check, Plus, Zap } from "@lucide/astro";
import Button from "../Button.astro";
import Animo from "../illustrations/Animo.astro";
import Sparkle from "../illustrations/Sparkle.astro";
import DashboardMockup from "../mockups/DashboardMockup.astro";
import PhoneMockup from "../mockups/PhoneMockup.astro";

const days = ["L", "M", "X", "J", "V", "S", "D"];
---

<section class="relative overflow-hidden bg-white pt-[13.5rem] pb-24 sm:pt-[15rem] xl:pt-40 md:pb-28" data-hero data-animo-field>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-40 -right-40 size-[26rem] rounded-full bg-sun-soft sm:size-[34rem]" data-parallax="0.3"></div>
    <div class="absolute top-[22rem] -left-48 size-[24rem] rounded-full bg-sky-soft sm:size-[30rem]" data-parallax="-0.3"></div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 top-0 h-[44rem] sm:h-[46rem]">
    <Animo tone="coral" face="inquieta" label="Inquieta" class="top-[7.5rem] left-[4%] size-16 sm:top-[9rem] sm:size-24 xl:left-[5%] xl:size-28" parallax={-0.5} />
    <Animo tone="sun" face="contenta" label="Contenta" class="top-[7rem] right-[4%] size-20 sm:top-[8.5rem] sm:size-28 xl:right-[6%] xl:size-32" parallax={-0.7} />
    <Animo tone="mint" face="tranquila" label="Tranquilo" class="top-[30rem] left-[7%] hidden size-20 lg:block xl:left-[13%]" parallax={-0.3} />
    <Animo tone="sky" face="apatica" label="Apático" class="top-[29rem] right-[7%] hidden size-24 lg:block xl:right-[12%]" parallax={-0.4} />
    <Animo tone="coral" face="sorprendida" class="top-[19rem] left-[2%] hidden size-14 xl:block xl:left-[4%]" parallax={-0.6} />
    <Animo tone="sun" face="emocionada" class="top-[19rem] right-[3%] hidden size-16 xl:block xl:right-[4%]" parallax={-0.2} />
    <Sparkle class="absolute top-[7rem] left-[30%] size-6 text-sun sm:size-9" style="--twinkle-delay: -1s" />
    <Sparkle class="absolute top-[13rem] right-[26%] hidden size-7 text-coral sm:block" style="--twinkle-delay: -2.2s" />
    <Sparkle class="absolute top-[27rem] left-[24%] hidden size-8 text-sky lg:block" />
    <Sparkle class="absolute top-[33rem] right-[28%] hidden size-6 text-mint lg:block" style="--twinkle-delay: -0.6s" />
  </div>

  <div class="shell relative text-center" data-hero-copy>
    <h1 class="display-xl mx-auto max-w-4xl" data-split>
      Llega a cada sesión sabiendo cómo se ha <em class="font-semibold text-[#d23a4c]">sentido</em>
    </h1>
    <p class="lead mx-auto mt-8 max-w-2xl text-ink/80 sm:mt-10" data-reveal style="--delay: 160ms">
      Tus pacientes registran emociones, pensamientos y situaciones. Tu equipo revisa lo que ha ocurrido entre consultas.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3" data-stagger style="--delay: 320ms">
      <Button href="#demo" variant="coral" class="min-h-14 px-8 text-lg">Pedir una demo</Button>
      <a href="#precios" class="text-link px-3 py-3">Ver precios <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
  </div>

  <div class="relative mt-20 px-3 perspective-[1400px] sm:mt-24 sm:px-4" data-reveal="scale" style="--delay: 420ms">
    <div class="pointer-events-none absolute inset-x-0 -top-10 mx-auto h-0 max-w-[78rem]">
      <Animo tone="mint" face="emocionada" class="right-[8%] -top-2 z-10 size-20 sm:-top-6 sm:size-24" />
    </div>
    <div class="relative mx-auto max-w-[78rem] overflow-hidden rounded-[2.5rem] bg-sun px-4 pt-10 pb-0 sm:rounded-[var(--radius-section)] sm:px-10 sm:pt-16" data-hero-stage>
      <div class="pointer-events-none absolute -right-16 -bottom-20 size-64 rounded-full bg-sun-light sm:size-96" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -top-24 -left-20 size-56 rounded-full bg-[#ffc93a] sm:size-80" aria-hidden="true"></div>

      <div class="relative mx-auto grid max-w-5xl items-end gap-6 lg:grid-cols-[auto_minmax(0,1fr)] lg:gap-10">
        <PhoneMockup class="mx-auto -mb-16 shadow-[0_40px_80px_-30px_#9a5b0099] lg:-mb-24 lg:-rotate-3">
          <div class="px-4 pt-4 pb-24">
            <ol class="grid grid-cols-7 gap-1 text-center text-[0.6rem] font-bold">
              {
                days.map((day, index) => (
                  <li class="flex flex-col items-center gap-1">
                    {day}
                    <span class:list={["grid size-6 place-items-center rounded-full", index === 0 ? "bg-coral text-ink ring-2 ring-ink" : "bg-sand"]}>
                      {index === 0 && <Check size={12} stroke-width={3} />}
                    </span>
                  </li>
                ))
              }
            </ol>
            <p class="mt-6 text-center text-[0.7rem] text-ink-soft">Hola, Laura</p>
            <p class="mx-auto mt-1 max-w-[11rem] text-center font-display text-xl leading-tight font-semibold">¿Cómo te sientes esta tarde?</p>
            <div class="relative mx-auto mt-5 grid size-36 place-items-center rounded-full border-[14px] border-coral">
              <span class="grid size-14 place-items-center rounded-full bg-white shadow-[0_10px_24px_-8px_#ff8f80aa]"><Plus size={24} /></span>
            </div>
            <p class="mx-auto mt-5 flex w-fit items-center gap-1 rounded-full bg-sun-soft px-3 py-1 text-[0.6rem] font-bold tracking-wide text-[#9a5b00] uppercase">
              <Zap size={11} fill="currentColor" /> 2 días de racha
            </p>
          </div>
        </PhoneMockup>
        <DashboardMockup class="hidden translate-y-6 shadow-[0_40px_80px_-30px_#9a5b0099] lg:block" />
      </div>
    </div>
    <p class="mt-6 text-center text-xs text-ink-soft">Vista ilustrativa de la app con datos ficticios.</p>
  </div>
</section>
