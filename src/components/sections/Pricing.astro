---
import { Check, Clock, Gift } from "@lucide/astro";
import Cta from "../Cta.astro";
import Animo from "../illustrations/Animo.astro";
import Sparkle from "../illustrations/Sparkle.astro";
import { emphasize, type Audience } from "../../lib/audiences";

const icons = { gift: Gift, clock: Clock };

interface Props {
  copy: Audience;
}

const { copy } = Astro.props;

const { main, secondary } = copy.pricing;
const MainIcon = icons[main.note.icon];
const SecondaryIcon = icons[secondary.note.icon];
---

<section id="precios" class="bg-cream py-24 sm:py-32">
  <div class="shell">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <h2 class="display-lg" data-split set:html={emphasize(copy.pricing.title, "font-semibold text-[#d23a4c]")} />
    </div>

    <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-2">
      <article class="card relative flex flex-col p-8 ring-4 ring-coral sm:p-10" data-reveal="left" data-tilt="4">
        <Animo variant="04_naranja_amarillo" class="-top-9 right-6 size-16 sm:size-20" />
        <Sparkle class="absolute -top-4 right-28 size-6 text-sun" />
        <h3 class="mb-6 font-display text-2xl tracking-tight">{main.name}</h3>
        <p class="flex items-end gap-2">
          <span class="font-display text-6xl tracking-tight tabular-nums" data-count={main.count} data-suffix={main.count && " €"}>{main.price}</span>
          {main.period && <span class="mb-2 text-ink-soft">{main.period}</span>}
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <p class="w-fit rounded-full bg-sun-soft px-3 py-1 text-sm font-bold text-[#9a5b00]">{main.badges[0]}</p>
          <p class="w-fit rounded-full bg-mint-soft px-3 py-1 text-sm font-bold text-[#157a43]">{main.badges[1]}</p>
        </div>
        <ul class="mt-8 mb-6 space-y-3" data-stagger style="--delay: 300ms">
          {
            main.features.map((feature) => (
              <li class="flex gap-3">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-coral"><Check size={13} stroke-width={3} /></span>
                {feature}
              </li>
            ))
          }
        </ul>
        <p class="mb-10 flex items-start gap-2 rounded-2xl bg-sun-soft p-4 text-sm">
          <MainIcon size={16} class="mt-0.5 shrink-0" />
          {main.note.text}
        </p>
        <Cta cta={main.cta} class="mt-auto justify-center" />
      </article>

      <article class="card relative flex flex-col overflow-hidden bg-sky p-8 sm:p-10" data-reveal="right" data-tilt="4" style="--delay: 100ms; --card-glow: #2953b866">
        <span class="pointer-events-none absolute -right-20 -bottom-20 size-64 rounded-full bg-sky-light" aria-hidden="true"></span>
        <h3 class="relative mb-6 font-display text-2xl tracking-tight">{secondary.name}</h3>
        <p class="relative font-display text-5xl tracking-tight">{secondary.price}</p>
        <p class="relative mt-3 text-ink/80">{secondary.text}</p>
        <ul class="relative mt-8 mb-6 space-y-3" data-stagger style="--delay: 400ms">
          {
            secondary.features.map((feature) => (
              <li class="flex gap-3">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-white"><Check size={13} stroke-width={3} /></span>
                {feature}
              </li>
            ))
          }
        </ul>
        <p class="relative mb-10 flex items-start gap-2 rounded-2xl bg-white/60 p-4 text-sm">
          <SecondaryIcon size={16} class="mt-0.5 shrink-0" />
          {secondary.note.text}
        </p>
        <Cta cta={secondary.cta} variant="light" class="relative mt-auto justify-center" />
      </article>
    </div>
  </div>
</section>
