---
import Animo from "../illustrations/Animo.astro";

const photo = "https://images.unsplash.com/photo-1758273241078-8eec353836be";
---

<section class="relative px-3 sm:px-4">
  <div class="pointer-events-none absolute inset-x-3 inset-y-0 mx-auto max-w-[90rem] sm:inset-x-4">
    <Animo tone="sun" face="contenta" label="Escuchada" class="-top-8 left-[8%] z-10 size-20 sm:-top-12 sm:size-28" />
    <Animo tone="sky" face="tranquila" class="right-[10%] -bottom-8 z-10 size-16 sm:-bottom-10 sm:size-24" />
  </div>
  <div class="relative mx-auto aspect-[4/5] max-w-[90rem] overflow-hidden rounded-[var(--radius-section)] sm:aspect-[16/9]" data-ribbon>
    <img
      src={`${photo}?w=1600&q=70&auto=format&fit=crop`}
      srcset={`${photo}?w=800&q=70&auto=format&fit=crop 800w, ${photo}?w=1600&q=70&auto=format&fit=crop 1600w, ${photo}?w=2400&q=70&auto=format&fit=crop 2400w`}
      sizes="100vw"
      alt="Una psicóloga conversa con su paciente en consulta"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 size-full object-cover"
      data-ribbon-image
    />
  </div>
</section>
