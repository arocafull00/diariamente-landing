---
import { Play } from "@lucide/astro";
---

<section class="relative -mt-12 rounded-t-[var(--radius-section)] bg-cream px-3 pt-16 sm:px-4 sm:pt-24">
  <div class="relative mx-auto max-w-[90rem]">
    <div class="relative aspect-video overflow-hidden rounded-[var(--radius-section)] bg-white" data-launch-video>
      <video
        src="/diariamente-launch.mp4"
        poster="/diariamente-launch-poster.jpg"
        controls
        playsinline
        preload="none"
        aria-label="Vídeo de lanzamiento de Diariamente"
        class="absolute inset-0 size-full object-cover"
      ></video>
      <button
        type="button"
        class="group absolute inset-0 flex cursor-pointer items-end justify-start bg-[url(/diariamente-launch-poster.jpg)] bg-cover bg-center p-4 sm:p-8"
        aria-label="Reproducir el vídeo de lanzamiento"
      >
        <span class="absolute inset-0 bg-gradient-to-t from-ink/35 via-transparent to-transparent transition-opacity duration-300 group-hover:opacity-70"></span>
        <span class="btn relative gap-2.5 px-4 transition-transform duration-300 group-hover:scale-105 sm:gap-3 sm:px-6 sm:text-lg">
          <span class="grid size-8 place-items-center rounded-full bg-white/90 sm:size-10">
            <Play size={18} fill="currentColor" aria-hidden="true" class="translate-x-px" />
          </span>
          Ver vídeo <span class="font-medium opacity-70">0:45</span>
        </span>
      </button>
    </div>
  </div>
</section>

<script>
  for (const wrap of document.querySelectorAll<HTMLElement>("[data-launch-video]")) {
    const video = wrap.querySelector("video");
    const cover = wrap.querySelector("button");
    cover?.addEventListener("click", () => {
      cover.remove();
      video?.play();
    });
  }
</script>
