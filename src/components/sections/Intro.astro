---
import { Image } from "astro:assets";
import persona from "../../assets/persona-pizarra.png";
import { ArrowRight } from "@lucide/astro";
import Animo from "../illustrations/Animo.astro";
import Sparkle from "../illustrations/Sparkle.astro";
---

<section class="relative -mt-12 rounded-t-[var(--radius-section)] bg-cream pt-20 pb-24 sm:pt-28 sm:pb-32">
  <div class="shell grid items-center gap-12 md:grid-cols-[1.1fr_0.9fr]">
    <div data-reveal="left">
      <h2 class="display-md max-w-xl">La semana de tu paciente, más allá de lo que <em class="font-semibold text-[#d23a4c]">recuerda</em> en consulta</h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">Diariamente recoge lo que vive cuando ocurre. Antes de la sesión, puedes revisar sus registros y decidir qué abordar juntos.</p>
      <a href="#como-funciona" class="text-link mt-7">Ver cómo es un registro <ArrowRight size={17} aria-hidden="true" /></a>
    </div>

    <div class="relative mx-auto w-full max-w-md" data-reveal="scale" style="--delay: 120ms">
      <Animo tone="sky" face="tranquila" label="Tranquila" class="top-[8%] -left-2 z-10 size-16 sm:-left-8 sm:size-20" />
      <Animo tone="sun" face="contenta" class="right-0 bottom-[12%] z-10 size-14 sm:-right-4 sm:size-16" />
      <Sparkle class="absolute top-0 right-[18%] z-10 size-7 text-sun" />
      <Image
        src={persona}
        alt="Ilustración de una paciente saludando desde su portátil"
        width={520}
        widths={[320, 520]}
        sizes="(min-width: 768px) 28rem, 90vw"
        class="w-full"
        data-parallax="-0.25"
      />
    </div>
  </div>
</section>
