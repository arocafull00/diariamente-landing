---
import PhoneMockup from "../mockups/PhoneMockup.astro";
import JourneyStep from "../JourneyStep.astro";

const steps = [
  { title: "Cómo se siente", text: "Elige una emoción y su intensidad.", tone: "bg-lila" },
  { title: "En qué contexto", text: "Indica dónde está, con quién y qué nota en su cuerpo.", tone: "bg-sky" },
  { title: "Qué ha ocurrido", text: "Puede profundizar en la situación, sus pensamientos y su conducta.", tone: "bg-sun" },
  { title: "Cuándo ha pasado", text: "Confirma la fecha y guarda el registro.", tone: "bg-mint" },
];
---

<section id="como-funciona" class="relative overflow-hidden rounded-[var(--radius-section)] bg-violet-deep py-24 text-white sm:py-32">
  <div class="shell grid items-center gap-16 lg:grid-cols-[1fr_auto]">
    <div>
      <div data-reveal>
        <h2 class="display-lg max-w-2xl">Qué registra tu paciente</h2>
        <p class="lead mt-6 max-w-xl text-white/85">Tu paciente puede guardar una emoción al momento o continuar para contar qué ha pasado.</p>
      </div>
      <ol class="mt-12 grid gap-3 sm:grid-cols-2">
        {steps.map((step, index) => <JourneyStep index={index + 1} {...step} />)}
      </ol>
    </div>
    <div class="mx-auto" data-reveal style="--delay: 150ms">
      <PhoneMockup class="rotate-2" />
    </div>
  </div>
</section>
