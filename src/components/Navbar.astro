---
import { Image } from "astro:assets";
import { Menu, X } from "@lucide/astro";
import logo from "../assets/diariamente-horizontal-color.svg";
import Button from "./Button.astro";
import { NAV_LINKS, SITE } from "../lib/site";
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4" data-header>
  <div class="mx-auto flex max-w-[78rem] items-stretch gap-2 sm:gap-3">
    <nav
      class="relative flex flex-1 items-center justify-between rounded-2xl bg-white py-2 pr-2 pl-3 shadow-[0_8px_30px_-12px_#25282c33] sm:pl-4"
      aria-label="Principal"
    >
      <a href="/" class="flex items-center py-1" aria-label="Diariamente, inicio">
        <Image src={logo} alt="" width={147} height={32} class="h-8 w-auto" loading="eager" />
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="rounded-xl px-3 py-2 text-[0.95rem] transition-colors hover:bg-sand">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={SITE.loginUrl} class="rounded-xl px-3 py-2 text-[0.95rem] text-ink-soft transition-colors hover:bg-sand">
            Acceder
          </a>
        </li>
      </ul>

      <button
        type="button"
        class="btn btn-light grid size-11 min-h-0 place-items-center p-0 text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <Menu size={20} class="menu-open" />
        <X size={20} class="menu-close hidden" />
      </button>

      <div
        id="mobile-menu"
        class="menu-panel absolute inset-x-0 top-[calc(100%+0.5rem)] hidden rounded-2xl bg-white p-2 shadow-[0_20px_40px_-16px_#25282c55] lg:hidden"
      >
        <ul class="flex flex-col">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="block rounded-xl px-4 py-3 text-lg hover:bg-sand" data-menu-link>
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={SITE.loginUrl} class="block rounded-xl px-4 py-3 text-lg text-ink-soft hover:bg-sand" data-menu-link>Acceder a la app</a>
          </li>
          <li class="p-2 sm:hidden" data-menu-link>
            <Button href="/#demo" variant="coral" class="w-full justify-center">Ver Diariamente en acción</Button>
          </li>
        </ul>
      </div>
    </nav>

    <div class="hidden items-center sm:flex">
      <Button href="/#demo" variant="coral">Pedir una demo</Button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    toggle.querySelector(".menu-open")?.classList.toggle("hidden", open);
    toggle.querySelector(".menu-close")?.classList.toggle("hidden", !open);
  };

  toggle?.addEventListener("click", () => setOpen(menu?.classList.contains("hidden") ?? false));
  document.querySelectorAll("[data-menu-link]").forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !menu?.contains(event.target) && !toggle?.contains(event.target)) setOpen(false);
  });
  window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
