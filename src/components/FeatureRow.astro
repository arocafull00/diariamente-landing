---
import Animo from "./illustrations/Animo.astro";

interface Props {
  tone: "coral" | "sky" | "sun" | "mint";
  title: string;
  text: string;
  reverse?: boolean;
}

const { tone, title, text, reverse = false } = Astro.props;

const panel = { coral: "bg-coral", sky: "bg-sky", sun: "bg-sun", mint: "bg-mint" }[tone];
const bubble = { coral: "bg-coral-light", sky: "bg-sky-light", sun: "bg-sun-light", mint: "bg-mint-light" }[tone];
const variant = ({ coral: "ansiedad", sky: "02_azul_rosa", sun: "04_naranja_amarillo", mint: "05_rosa_verde" } as const)[tone];
---

<div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
  <div class:list={["relative", reverse && "md:order-2"]} data-reveal="scale">
    <div class:list={["relative flex min-h-[20rem] items-center justify-center overflow-hidden rounded-[2.5rem] px-6 py-12 sm:min-h-[26rem]", panel]} data-tilt="6">
      <div class:list={["pointer-events-none absolute -right-16 -bottom-16 size-56 rounded-full sm:size-72", bubble]} aria-hidden="true"></div>
      <div class:list={["pointer-events-none absolute -top-10 -left-10 size-28 rounded-full opacity-70", bubble]} aria-hidden="true"></div>
      <div class="relative w-full max-w-sm" data-parallax="-0.12">
        <slot />
      </div>
    </div>
    <Animo variant={variant} class:list={["-top-7 z-10 size-16 sm:size-20", reverse ? "-left-3 sm:-left-6" : "-right-3 sm:-right-6"]} />
  </div>

  <div class:list={["px-2 py-4 sm:px-6 md:max-w-lg", reverse ? "md:justify-self-start" : "md:justify-self-end"]} data-reveal={reverse ? "left" : "right"} style="--delay: 120ms">
    <h3 class="display-md">{title}</h3>
    <p class="mt-4 text-[1.05rem] leading-relaxed text-ink-soft">{text}</p>
  </div>
</div>
