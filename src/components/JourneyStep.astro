---
import NumberBlob from "./illustrations/NumberBlob.astro";

interface Props {
  index: number;
  title: string;
  text: string;
  tone: "coral" | "sun" | "mint" | "sky";
}

const { index, title, text, tone } = Astro.props;
---

<li class="card flex gap-4 p-4" style="--card-glow: #9c2f2466" data-lift data-wiggle>
  <span data-wiggle-target><NumberBlob tone={tone === "coral" ? "sun" : tone} class="size-11 text-lg">{index}</NumberBlob></span>
  <span>
    <span class="block font-bold">{title}</span>
    <span class="mt-1 block text-sm leading-relaxed text-ink-soft">{text}</span>
  </span>
</li>
