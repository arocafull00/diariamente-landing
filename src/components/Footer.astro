---
import { Image } from "astro:assets";
import logo from "../assets/diariamente-horizontal-color.svg";
import { NAV_LINKS, SITE } from "../lib/site";
import Animo from "./illustrations/Animo.astro";

const moods = [
  { tone: "sun", face: "contenta" },
  { tone: "sky", face: "tranquila" },
  { tone: "mint", face: "emocionada" },
  { tone: "coral", face: "sorprendida" },
] as const;

const year = new Date().getFullYear();
---

<footer class="bg-cream pb-10">
  <div class="mb-16 overflow-hidden bg-coral py-5" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {[0, 1, 2].map(() =>
              moods.map((mood) => (
                <div class="flex items-center gap-6 pr-6">
                  <span class="font-display text-2xl font-semibold whitespace-nowrap sm:text-3xl">¿Cómo te sientes hoy?</span>
                  <div class="relative size-10 shrink-0 sm:size-12">
                    <Animo tone={mood.tone} face={mood.face} class="inset-0" />
                  </div>
                </div>
              )),
            )}
          </div>
        ))
      }
    </div>
  </div>
  <div class="shell">
    <div class="flex flex-col gap-10 border-b border-line pb-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <a href="/" class="inline-flex" aria-label="Diariamente, inicio">
          <Image src={logo} alt="" width={184} height={40} class="h-10 w-auto" />
        </a>
        <p class="mt-4 text-ink-soft">Seguimiento TCC entre sesiones para clínicas de psicología.</p>
      </div>
      <nav aria-label="Pie de página" class="grid grid-cols-2 gap-x-12 gap-y-3 text-ink-soft">
        {NAV_LINKS.map((link) => <a href={link.href} class="hover:text-ink">{link.label}</a>)}
        <a href="/#demo" class="hover:text-ink">Solicitar demo</a>
        <a href={SITE.loginUrl} class="hover:text-ink">Acceder a la app</a>
        <a href="/privacidad" class="hover:text-ink">Privacidad</a>
      </nav>
    </div>
    <div class="flex flex-col gap-3 pt-8 text-sm text-ink-soft md:flex-row md:justify-between">
      <p>© {year} Diariamente</p>
      <p class="max-w-xl md:text-right">
        Diariamente no sustituye la terapia ni la atención de urgencias. Si estás en crisis, llama al 024 o al 112.
      </p>
    </div>
  </div>
</footer>
