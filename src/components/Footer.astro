---
import { Image } from "astro:assets";
import logoMark from "../assets/diariamente-logo.png";
import wordmark from "../assets/diariamente-wordmark.svg";
import { SITE } from "../lib/site";
import { AUDIENCES, type Audience } from "../lib/audiences";
import Animo from "./illustrations/Animo.astro";

interface Props {
  copy: Audience;
  landing: boolean;
}

const { copy, landing } = Astro.props;
const anchor = (href: string) => (!landing && href.startsWith("#") ? `/${href}` : href);

const moods = [
  "alegria",
  "ansiedad",
  "rabia",
  "tristeza",
] as const;

const year = new Date().getFullYear();
const others = Object.values(AUDIENCES).filter((audience) => audience.key !== copy.key);
---

<footer class="bg-cream pb-10">
  <div class="mb-16 overflow-hidden bg-coral py-5" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {[0, 1, 2].map(() =>
              moods.map((mood) => (
                <div class="flex items-center gap-6 pr-6">
                  <span class="font-display text-2xl font-semibold whitespace-nowrap sm:text-3xl">¿Cómo te sientes hoy?</span>
                  <div class="relative size-10 shrink-0 sm:size-12">
                    <Animo variant={mood} class="inset-0" />
                  </div>
                </div>
              )),
            )}
          </div>
        ))
      }
    </div>
  </div>
  <div class="shell">
    <div class="flex flex-col gap-10 border-b border-line pb-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <a href="/" class="inline-flex items-center gap-2.5" aria-label="Diariamente, inicio">
          <Image src={logoMark} alt="" width={40} height={40} class="size-10" />
          <Image src={wordmark} alt="" width={143} height={20} class="h-5 w-auto" />
        </a>
        <p class="mt-4 text-ink-soft">{copy.footer.tagline}</p>
      </div>
      <nav aria-label="Pie de página" class="grid grid-cols-2 gap-x-12 gap-y-3 text-ink-soft">
        {copy.nav.map((link) => <a href={anchor(link.href)} class="hover:text-ink">{link.label}</a>)}
        <a href={anchor("#clinicas")} class="hover:text-ink">{copy.footer.formLink}</a>
        {others.map((audience) => <a href={audience.url} class="hover:text-ink">{audience.name}</a>)}
        <a href={SITE.loginUrl} class="hover:text-ink">Acceder a la app</a>
        <a href={SITE.playStoreUrl} class="hover:text-ink">Google Play</a>
        <a href="/privacidad" class="hover:text-ink">Privacidad</a>
      </nav>
    </div>
    <div class="flex flex-col gap-3 pt-8 text-sm text-ink-soft md:flex-row md:justify-between">
      <p>© {year} Diariamente</p>
      <p class="max-w-xl md:text-right">
        Diariamente no sustituye la terapia ni la atención de urgencias. Si estás en crisis, llama al 024 o al 112.
      </p>
    </div>
  </div>
</footer>
